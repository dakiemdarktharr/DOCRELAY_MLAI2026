generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id        String   @id @default(cuid())
  type      String
  actor     String
  metadata  Json
  createdAt DateTime @default(now())

  @@index([createdAt])
}
